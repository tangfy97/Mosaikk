    "%lld files couldn’t be added because they aren’t pictures Mosaikk can read.": {
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files couldn’t be added because they aren’t pictures Mosaikk can read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个文件无法添加，因为 Mosaikk 无法读取这些图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 個檔案無法加入，因為 Mosaikk 無法讀取這些圖片。"
          }
        }
      }
    },
